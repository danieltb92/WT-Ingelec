---
import Cases from "@/components/sections/Cases.astro";
import Contact from "@/components/sections/Contact.astro";
import Hero from "@/components/sections/Hero.astro";
import About from "@/components/sections/About.astro";
import CTA from "@/components/sections/CTA.astro";
import Services from "@/components/sections/Services.astro";
import Sponsors from "@/components/sections/Sponsors.astro";
import Team from "@/components/sections/Team.astro";
import MainLayout from "@/layouts/MainLayout.astro";

// TODO: activar la sección Team cuando el cliente confirme (flip a true)
// Nota: se usa flag en frontmatter en vez de comentar el bloque, por el
// quirk "comentar bloques con <!-- --> en .astro" del AGENTS.md.
const SHOW_TEAM = false;
---

<MainLayout
  title="WT Ingelec SAS | Soluciones Eléctricas y de Ingeniería"
  description="En WT Ingelec, somos líderes en ofrecer soluciones eléctricas y de ingeniería innovadoras y confiables para el sector industrial y comercial."
>
  <Hero />
  <Sponsors />
  <About />
  <Services />
  <CTA />
  <Cases />
  <Contact />
  {SHOW_TEAM && <Team />}
</MainLayout>
