---
import { Image } from "astro:assets";
import MainLayout from "@/layouts/MainLayout.astro";
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import Section from "@/components/sections/Section.astro";
import AccordionServices from "@/components/sections/AccordionServices.astro";
import imageMain from "@/assets/pics/section-services2.webp";
import Button from "@/components/ui/Button.astro";

const services = [
  "Ingeniería y Diseño Eléctrico",
  "Montajes y Construcción",
  "Automatización y Control de Procesos",
  "Mantenimiento Industrial",
];
---

<MainLayout
  description="Servicios integrales de ingeniería eléctrica: montajes eléctricos, automatización, control de procesos, modernización de plantas, diseño y asesoría técnica para industria y comercio."
>
  <main>
    <!-- Structured Data SEO -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "provider": {
        "@type": "Organization",
        "name": "WT Ingelec SAS",
        "url": "https://www.wtingelec.com.co"
      },
      "areaServed": {
        "@type": "Country",
        "name": "Colombia"
      },
      "serviceType": services,
      "description": "Servicios integrales de ingeniería eléctrica para industria y comercio en Colombia."
    })} />

    <Breadcrumb items={[{ name: "Servicios", href: "/services/" }]} />

    <!-- Hero Section -->
    <div
      class="relative pt-32 pb-16 md:pt-40 md:pb-20 overflow-hidden"
    >
      <!-- Acento dorado sutil -->
      <div
        class="absolute -top-24 -right-24 w-72 h-72 bg-[var(--color-accent)] rounded-full opacity-10 blur-3xl"
      >
      </div>
      <div class="relative z-10 max-w-4xl mx-auto text-center px-6">
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-medium text-black mb-6 gsap-fade-up"
        >
          Servicios <span class="text-[var(--color-accent)] font-bold">Eléctricos</span> Integrales
        </h1>
        <p
          class="text-lg md:text-xl text-black max-w-2xl mx-auto gsap-fade-up"
        >
          Desde el diseño hasta el mantenimiento, soluciones de ingeniería de
          vanguardia para la industria y el comercio.
        </p>
      </div>
    </div>

    <!-- Introducción con imagen -->
    <Section>
      <div class="py-12 md:py-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <div class="gsap-fade-up">
            <Image
              src={imageMain}
              alt="Equipo de WT Ingelec realizando montaje eléctrico industrial"
              class="w-full h-auto rounded-sm shadow-lg"
            />
          </div>
          <div class="space-y-6 gsap-fade-up">
            <h2 class="text-2xl md:text-3xl font-medium">
              Soluciones que Impulsan tu Negocio
            </h2>
            <p class="text-[var(--color-text-secondary)] leading-7">
              En WT Ingelec SAS, ofrecemos un portafolio completo de soluciones de
              ingeniería eléctrica que abarcan todas las fases de tu proyecto.
              Nuestra experiencia nos permite proveer un servicio integral en la
              gestión, ingeniería, suministro y construcción de obras eléctricas,
              cumpliendo con las normas y reglamentos exigidos por la ley nacional e
              internacional.
            </p>
            <p class="text-[var(--color-text-secondary)] leading-7">
              Nuestro compromiso es generar soluciones que se traduzcan en mayor
              productividad, eficiencia, confiabilidad y menores costos de
              mantenimiento.
            </p>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
              {services.map((service) => (
                <li class="flex items-center gap-2 text-sm text-[var(--color-text-secondary)]">
                  <svg class="w-5 h-5 text-[var(--color-accent)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {service}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Section>

    <!-- Accordion de servicios -->
    <AccordionServices />

    <!-- CTA Final -->
    <Section>
      <div
        class="relative overflow-hidden rounded-md my-12 md:my-20"
      >
        <div
          class="absolute inset-0 bg-gradient-to-br from-[#001f4d] via-[var(--color-primary)] to-[#0055a5]"
        >
        </div>
        <div
          class="absolute -top-20 -right-20 w-64 h-64 bg-[var(--color-accent)] rounded-full opacity-15 blur-3xl"
        >
        </div>
        <div
          class="absolute -bottom-16 -left-16 w-48 h-48 bg-[var(--color-accent)] rounded-full opacity-10 blur-3xl"
        >
        </div>
        <div
          class="relative z-10 w-full px-6 py-16 md:py-20 flex flex-col items-center gap-6 text-center"
        >
          <h2
            class="text-3xl md:text-4xl font-medium text-white gsap-fade-up"
          >
            ¿Necesitas una cotización?
          </h2>
          <p class="text-white text-lg max-w-xl gsap-fade-up">
            Cuéntanos sobre tu proyecto y te ofreceremos la mejor solución técnica y económica.
          </p>
          <Button
            variant="tertiary"
            size="md"
            href="/#contact"
            class="mt-2 gsap-fade-up"
          >
          Solicitar Cotización
          </Button>
          <!-- <a
            href="/#contact"
            class="inline-flex items-center justify-center font-grotesk font-medium rounded-sm px-6 py-3 bg-white text-[var(--color-primary)] hover:bg-[var(--color-accent)] hover:text-[var(--color-dark)] transition-all duration-200 mt-2 gsap-fade-up focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
          >
            Solicitar Cotización
          </a> -->
        </div>
      </div>
    </Section>
  </main>
</MainLayout>
