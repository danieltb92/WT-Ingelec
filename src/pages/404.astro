---
import MainLayout from "@/layouts/MainLayout.astro";
import Button from "@/components/ui/Button.astro";
---

<MainLayout
  title="Página no encontrada | WT Ingelec SAS"
  description="La página solicitada no existe o fue movida. Vuelve al inicio de WT Ingelec SAS para encontrar soluciones eléctricas y de ingeniería."
  robots={true}
>
  <section class="mt-16 flex-1 flex items-center px-6 py-16 md:py-24">
    <div
      class="w-full max-w-[1280px] mx-auto grid items-center gap-12 md:grid-cols-2 md:gap-16"
    >
      <div class="text-center md:text-left">
        <p
          class="mb-4 text-sm font-medium uppercase tracking-[0.08em] text-[var(--color-primary)]"
        >
          Error 404
        </p>
        <h1
          class="text-4xl font-medium leading-[1.05] tracking-[-0.02em] md:text-5xl lg:text-6xl"
        >
          No encontramos esta página
        </h1>
        <p
          class="mx-auto mt-6 max-w-md text-lg text-[var(--color-text-secondary)] md:mx-0"
        >
          Puede que el enlace esté mal escrito o que la página se haya movido.
          Volvamos a un lugar conocido.
        </p>
        <div
          class="mt-10 flex flex-col justify-center gap-4 sm:flex-row md:justify-start"
        >
          <Button variant="primary" size="md" href="/">Volver al inicio</Button>
          <Button variant="outline" size="md" href="/services/">
            Ver servicios
          </Button>
        </div>
      </div>
      <img
        src="/404.svg"
        alt=""
        class="mx-auto w-full max-w-[360px] md:max-w-[420px] order-first md:order-last"
      />
    </div>
  </section>
</MainLayout>
