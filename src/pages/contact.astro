---
import MainLayout from "@/layouts/MainLayout.astro";
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import Section from "@/components/sections/Section.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import Badge from "@/components/ui/Badge.astro";
import Form from "@/components/ui/Form.astro";
import Button from "@/components/ui/Button.astro";

const contactInfo = [
  {
    icon: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
    title: "Correo Electrónico",
    content: "info@wtingelec.com.co",
    meta: "Para consultas formales y documentación",
    href: "mailto:info@wtingelec.com.co",
    external: false,
  },
  {
    icon: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
    title: "Teléfono",
    content: "+57 311 510 9251",
    meta: "Atención directa con ingeniería",
    href: "tel:+573115109251",
    external: false,
  },
  {
    icon: "M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8.9h.5a8.48 8.48 0 018 8v.5z",
    title: "WhatsApp",
    content: "+57 311 510 9251",
    meta: "El canal más rápido, ideal para urgencias",
    href: "https://wa.me/573115109251",
    external: true,
  },
  {
    icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z",
    title: "Ubicación",
    content: "Bogotá, Colombia",
    meta: "Cobertura nacional",
    href: "https://www.google.com/maps/search/?api=1&query=Bogot%C3%A1%2C+Colombia",
    external: true,
  },
];

const trustPoints = [
  {
    title: "Respuesta en 24 horas",
    text: "Garantizada en días hábiles: cierres la decisión o sigas comparando, nunca te quedas sin respuesta.",
  },
  {
    title: "+10 años de experiencia",
    text: "Más de 200 proyectos entregados en industria, comercio y estaciones de servicio.",
  },
  {
    title: "Cumplimiento normativo",
    text: "Normativas nacionales e internacionales en cada diseño, montaje y legalización.",
  },
  {
    title: "Gestión completa",
    text: "Ingeniería, suministro y construcción bajo un solo responsable de proyecto.",
  },
];

const faqs = [
  {
    question: "¿En cuánto tiempo responden a las cotizaciones?",
    answer:
      "Nuestro equipo técnico evalúa cada solicitud y envía una propuesta preliminar en menos de 24 horas hábiles. Para proyectos complejos, coordinamos una llamada técnica previa.",
  },
  {
    question: "¿Realizan visitas técnicas sin compromiso?",
    answer:
      "Sí, ofrecemos visita técnica de diagnóstico sin costo para proyectos en Bogotá y ciudades principales. Para otras ubicaciones, coordinamos según alcance del proyecto.",
  },
  {
    question: "¿Qué información necesitan para cotizar?",
    answer:
      "Básicamente: tipo de proyecto, ubicación, planos o croquis si los tienes, carga estimada y cualquier requisito normativo específico. Si no tienes planos, agendamos la visita técnica.",
  },
  {
    question: "¿Atienden emergencias eléctricas?",
    answer:
      "Sí. Clientes con planes de mantenimiento cuentan con canal de emergencias por WhatsApp, incluso fuera del horario habitual de atención.",
  },
  {
    question: "¿Qué tipos de proyecto atienden?",
    answer:
      "Montajes eléctricos, subestaciones, tableros, grupos electrógenos, automatización y control de procesos, modernización de plantas y legalización de proyectos ante las operadoras de red.",
  },
];
