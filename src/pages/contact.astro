<MainLayout
  title="Contacto | WT Ingelec SAS"
  description="Contacta a WT Ingelec SAS para soluciones eléctricas e ingeniería en Colombia. Envíanos tu consulta, solicita presupuesto o escríbenos por WhatsApp. Atendemos industria y comercio."
>
  <main>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ContactPage",
        name: "Contacto WT Ingelec",
        description:
          "Página de contacto de WT Ingelec SAS - Soluciones eléctricas e ingeniería en Colombia",
        url: "https://www.wtingelec.com.co/contact/",
        mainEntity: {
          "@type": "Organization",
          name: "WT Ingelec SAS",
          url: "https://www.wtingelec.com.co",
          telephone: "+57-311-510-9251",
          email: "info@wtingelec.com.co",
          address: {
            "@type": "PostalAddress",
            addressCountry: "CO",
            addressLocality: "Bogotá",
          },
          contactPoint: {
            "@type": "ContactPoint",
            telephone: "+57-311-510-9251",
            contactType: "customer service",
            email: "info@wtingelec.com.co",
            areaServed: "CO",
            availableLanguage: "es",
          },
        },
      })}
    />

    <Breadcrumb items={[{ name: "Contacto", href: "/contact/" }]} />

    <!-- ============ HERO + FORMULARIO EMBEBIDO ============ -->
    <section
      id="contacto"
      class="relative overflow-hidden mt-6 md:mt-8 pt-6 pb-16 md:pt-8 md:pb-24"
    >
      <div
        class="relative z-10 mx-auto grid w-full max-w-7xl items-start gap-10 px-6 lg:grid-cols-[1fr_0.95fr] lg:gap-14"
      >
        <!-- Texto del hero -->
        <div class="gsap-fade-up">
          <Badge
            text="Cotización sin compromiso"
            variant="light"
            class="mb-5"
          />
          <h1
            class="mb-6 text-4xl font-medium leading-tight text-black md:text-5xl lg:text-6xl"
          >
            Hablemos de tu <span class="font-bold text-[#FFB800]"
              >proyecto eléctrico</span
            >
          </h1>
          <p class="mb-8 max-w-xl text-base text-black/70 md:text-lg">
            Desde el diagnóstico hasta la puesta en marcha: déjanos tus datos en
            el formulario y te responderemos en menos de 24 horas hábiles.
          </p>

          <div class="flex flex-wrap gap-3">
            <Button
              variant="primary"
              size="md"
              href="https://wa.me/573115109251"
              target="_blank"
              rel="noopener noreferrer"
            >
              Escríbenos por WhatsApp
            </Button>
            <Button 
              variant="outline" 
              size="md" 
              href="tel:+573115109251"
            >
              Llámanos: +57 311 510 9251
            </Button>
          </div>
        </div>

        <!-- Tarjeta con el formulario -->
        <div
          class="gsap-fade-up rounded-sm border border-[var(--color-border)] bg-white p-6 sm:p-8 lg:p-10"
        >
          <!-- Confirmación de envío -->
          <div
            id="contact-feedback"
            role="status"
            aria-live="polite"
            hidden
            class="mb-6 flex items-start gap-3 rounded-sm border-l-4 border-[var(--color-success)] bg-[var(--color-bg-secondary)] p-5"
          >
            <svg
              class="mt-0.5 h-6 w-6 shrink-0 text-[var(--color-success)]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <p class="font-medium text-[var(--color-text-primary)]">
                ¡Mensaje enviado!
              </p>
              <p class="text-sm text-[var(--color-text-secondary)]">
                Recibimos tu mensaje y nos pondremos en contacto contigo en
                menos de 24 horas.
              </p>
            </div>
          </div>

          <Form
            title="Solicita tu Cotización"
            description="Cuéntanos sobre tu proyecto: entre más detalle nos compartas, más precisa será tu cotización."
          />
        </div>
      </div>
    </section>

