<style>
  /* El banner de éxito solo debe verse tras el envío: la clase .flex de Tailwind
     (display:flex) vence al atributo [hidden] nativo del navegador sin esta regla */
  #contact-feedback[hidden] {
    display: none !important;
  }
</style>
