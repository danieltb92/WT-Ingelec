---
import { Image } from "astro:assets";
import decorForm from "@/assets/pics/form-img.webp";
import Form from "@/components/ui/Form.astro";
import Section from "@/components/sections/Section.astro";
---

<Section id="contact" class="bg-[var(--color-bg-dark)]">
  <div class="overflow-hidden mt-0 md:mb-10 relative gsap-fade-up">
    <div class="w-full mx-auto p-0 py-20 sm:p-10">
      <div
        class="grid w-full mx-auto grid-cols-1 lg:grid-cols-[0.8fr_1fr] items-stretch rounded-sm overflow-hidden"
      >
        <div
          class="bg-white shadow-[0_25px_80px_rgba(0,0,0,0.08)] p-6 sm:p-8 lg:p-10 flex flex-col justify-between"
        >
          <Form title="Contáctanos" />
        </div>

        <div
          class="hidden lg:block overflow-hidden shadow-[0_25px_80px_rgba(0,0,0,0.08)]"
        >
          <Image
            src={decorForm}
            alt=""
            class="h-full w-full object-cover min-h-[420px] lg:min-h-[520px]"
          />
        </div>
      </div>
    </div>
  </div>
</Section>